# GYN website — backend environment variables
# Copy to .env.local (never commit real values).
# All secrets must be in a secrets manager (Vercel env, Railway, AWS SSM) in production.

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL — Singapore region ap-southeast-1)
# ---------------------------------------------------------------------------

# Pooled connection URL for the application server (Neon serverless pooler, PgBouncer-compatible).
# Use the "-pooler" hostname from the Neon dashboard. The pg Pool max:5 in lib/db.ts limits
# simultaneous connections; no pgbouncer=true or connection_limit URL params needed with adapter-pg.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DATABASE?sslmode=require"

# Direct (non-pooled) connection URL for Prisma migrate — bypasses PgBouncer.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/DATABASE?sslmode=require"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Secret key — use sk_test_... in development, sk_live_... in production
STRIPE_SECRET_KEY="sk_test_..."

# Publishable key — safe to expose to the frontend (pk_test_... / pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook signing secret from Stripe Dashboard > Developers > Webhooks
# (run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in dev to get one)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Payoneer (stub — not used at launch; see docs/payments.md)
# ---------------------------------------------------------------------------

# PAYONEER_PROGRAM_ID=""
# PAYONEER_USERNAME=""
# PAYONEER_API_KEY=""

# ---------------------------------------------------------------------------
# Resend (transactional email: registration confirmations, scholarship results)
# ---------------------------------------------------------------------------

RESEND_API_KEY="re_..."
# From address must be a verified domain in Resend
EMAIL_FROM="GYN Events <events@thegyn.org>"

# ---------------------------------------------------------------------------
# Cloudinary (media uploads)
# ---------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: restrict uploads to a specific folder
CLOUDINARY_UPLOAD_PRESET=""

# ---------------------------------------------------------------------------
# Upstash Redis (rate-limiting, webhook queue, session cache)
# ---------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA on forms — replaces the current reCAPTCHA)
# ---------------------------------------------------------------------------

# Site key — safe to expose to the frontend
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Secret key — server-side verification only
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Base URL used for Stripe success/cancel redirect URLs and email links
NEXT_PUBLIC_BASE_URL="https://thegyn.org"

# Admin JWT signing secret (min 32 random bytes, base64-encoded)
AUTH_SECRET=""

# Node environment
NODE_ENV="development"
