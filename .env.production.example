# GYN production environment variables.
# Copy this file to .env on the VPS and fill in every value.
# .env must NEVER be committed to git; it stays on the server only.
# Secrets come from this file at runtime; they are never baked into a Docker image.


# --- Database ---

# Password for the gyn Postgres user. Use at least 32 random characters.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Connection string used by the app at runtime (through the pg connection pool).
# Host is "db" (the postgres service name inside the Docker network).
DATABASE_URL=postgresql://gyn:REPLACE_WITH_STRONG_PASSWORD@db:5432/gyn

# Direct (un-pooled) connection for prisma migrate deploy.
# On this single-VPS setup without PgBouncer, this is the same as DATABASE_URL.
DIRECT_URL=postgresql://gyn:REPLACE_WITH_STRONG_PASSWORD@db:5432/gyn

# Maximum pg connection pool size per process (app + worker each have their own pool).
# Keep app + worker + migrate total under PG_MAX_CONNECTIONS.
# Default: 10 per process, 50 max connections for Postgres.
DB_POOL_MAX=10

# Postgres shared_buffers (roughly 25% of server RAM is a good starting point).
# Safe default for an unknown-RAM VPS; raise once you know the specs.
PG_SHARED_BUFFERS=128MB

# Postgres max_connections. Each connection uses ~5-10 MB of server RAM.
PG_MAX_CONNECTIONS=50


# --- Site ---

# Public domain for Caddy's automatic HTTPS. Use the bare domain or www prefix, not both.
# Example: thegyn.org  or  www.thegyn.org
# To run behind an existing server on a test subdomain, see the commented-out block at the bottom of deploy/Caddyfile.
SITE_ADDRESS=thegyn.org

# The separate admin app lives on its own subdomain (its own container, login and sessions). Needs a DNS record too.
ADMIN_ADDRESS=admin.thegyn.org

# Optional: restrict who can even reach the admin. Space-separated addresses or ranges, e.g. "203.0.113.7 198.51.100.0/24".
# Leave out to allow everyone (the admin still needs a login).
# ADMIN_ALLOWED_IPS=

# Shared secret the admin uses to tell the website to refresh pages after publishing (private Docker network only).
# Generate: openssl rand -base64 32
INTERNAL_API_SECRET=REPLACE_WITH_RANDOM_SECRET

# Public base URL used by the app for absolute links (emails, sitemaps, Open Graph).
# No trailing slash.
NEXT_PUBLIC_BASE_URL=https://thegyn.org


# --- Storage ---

# Directory where uploaded files are stored. Must match the volume mount in docker-compose.yml.
# Public media: $STORAGE_DIR/public/   Private documents: $STORAGE_DIR/private/
STORAGE_DIR=/data/uploads

# Minimum free disk bytes before the app refuses new uploads (disk-full protection).
# Default: 500 MB = 524288000. Raise the alert threshold (75% full) in your monitoring separately.
MIN_FREE_BYTES=524288000


# --- Field Encryption ---
# Sensitive form fields (passport numbers, ID numbers, DOB) are encrypted with AES-256-GCM
# before being stored. The key never touches the database.
#
# Format: "KEY_ID:BASE64_32_BYTES"  (e.g. "1:abc...xyz=")
# Generate a key: openssl rand -base64 32
# Prepend the key ID (start at 1; increment when rotating).
FIELD_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTES

# The key ID currently used for new encryptions. Must match a key in FIELD_ENCRYPTION_KEYS.
FIELD_ENCRYPTION_KEY_ID=1


# --- Email (SMTP) ---

# Your outgoing mail server. Any provider that offers SMTP works.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@thegyn.org
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=GYN <noreply@thegyn.org>


# --- Stripe ---
# Use test keys (sk_test_...) until go-live.
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE


# --- PayPal ---
# PAYPAL_ENV: "sandbox" for testing, "live" for production.
PAYPAL_CLIENT_ID=REPLACE
PAYPAL_CLIENT_SECRET=REPLACE
PAYPAL_WEBHOOK_ID=REPLACE
PAYPAL_ENV=live


# --- Cloudflare Turnstile (bot protection on public forms) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is baked into the JS bundle at build time (public key, not a secret).
# TURNSTILE_SECRET_KEY is verified server-side only (keep it secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# IMPORTANT: never set ALLOW_DEMO_ACCOUNTS in production. It creates the six demo admin accounts that share a public
# password and exist only for local development and staging demos.
# Guards /pitch. Leave empty to leave it open.
PITCH_BASIC_AUTH=
