    "chapters": {
      "visible": true,
      "kicker": "Past summit programme",
      "heading": "Programme *chapters*",
      "items": [
        {
          "label": "Chapter 1",
          "title": "Global Collaboration & Leadership",
          "text": "Global leaders discuss how collaboration and leadership drive innovation across sustainable development.",
          "sessions": [
            {
              "type": "Keynote",
              "title": "From Local Action to Global Impact: Leading Collaborative Solutions for the SDGs – Kehkashan Basu (Green Hope Foundation)"
            },
            {
              "type": "Interactive Keynote",
              "title": "Bring Your Own Chair — 2000 to 2015 to 2030 to 2045: MDG to SDG to???? – Dr. Suman Roy (Zero Hunger Project)"
            },
            {
              "type": "Keynote",
              "title": "Advancing Women’s Rights through Global Collaboration & Leadership – Dr. Methinee Wongwanich Rumpagaporn (Kasetsart University & BINA Thailand)"
            }
          ]
        },
        {
          "label": "Chapter 2",
          "title": "Connecting Strategy, Policy & Social Impact",
          "text": "Workshops and keynotes on policy formulation and strategic decision-making for sustainable futures.",
          "sessions": [
            {
              "type": "Policy Workshop",
              "title": "Transforming Education through Inclusive Policies and Innovation – Dr. Mona Al Kadi. (Axxon Group, MENA)"
            },
            {
              "type": "Entrepreneurship Workshop",
              "title": "Profit, People, Planet: A Lean Approach for Organizational Excellence – Sura Fitiani (Intersect Innovation Hub, Palestine)"
            },
            {
              "type": "Keynote",
              "title": "Feminist Climate Governance: Gender Mainstreaming in Climate Policy Making – Sidra Riaz (Environmental Change Makers, FIU)"
            }
          ]
        },
        {
          "label": "Chapter 3 – Summit Theme",
          "title": "Exploring Sustainability through Innovative Minds",
          "text": "The delegate-led heart of the summit — see World Got a Problem below.",
          "sessions": [
            {
              "type": "Interactive Delegate Activity",
              "title": "World Got a Problem — Group Formation, Brainstorming, Presentations & Evaluation"
            }
          ]
        },
        {
          "label": "Chapter 4",
          "title": "AI Corner: Smart Innovation, Human Rights & AI",
          "text": "A dedicated space exploring artificial intelligence, innovation and human rights with tech leaders and sustainability experts.",
          "sessions": [
            {
              "type": "Keynote",
              "title": "AI as Sustainable Digital Infrastructure: Building Inclusive, Trusted, Impact-Driven Innovation Ecosystems – Wenbo Li (Poly-Gamma, Greater China)"
            },
            {
              "type": "Interactive Workshop",
              "title": "Smart Innovation: AI, Gender Equality, and Human Rights Education — A Boon or a Challenge? – Dr. Shaleen Das (Youth for Human Rights International)"
            },
            {
              "type": "AI Fireside Chat",
              "title": "Innovation at the Intersection of AI and Immersive Experiences. -Ashley Blake (vrCAVE Canada) Syed Bilal Qasim (Techsol Space)"
            },
            {
              "type": "AI Panel Discussion",
              "title": "Future Minds and a Sustainable Future: Navigating the AI Revolution – Moderated by Sura Fitiani with Al Kadi, Roy, Li & Dr. Rishi Jain (AIT Bangkok)"
            }
          ]
        }
      ]
    },
    "schedule": {
      "visible": true,
      "kicker": "Four days",
      "heading": "Four days *on the ground*",
      "days": [
        {
          "label": "Day 1 Inaugural Evening",
          "date": "16 July",
          "items": [
            {
              "title": "Passport Bingo",
              "text": "An icebreaking challenge that sent delegates around the venue to find peers matching five prompts — from multilingual speakers to fellow travelers and gender-equality advocates — building the summit's first connections and a social-media trail under #FMST26."
            }
          ]
        },
        {
          "label": "Day 2",
          "date": "17 July 2026",
          "items": [
            {
              "title": "World Got a Problem — Phase A",
              "text": "Delegates chose the SDG they were most passionate about, formed teams, elected a group representative, and identified one significant global problem to solve — with guest speakers and fellows on hand as mentors. An evening sightseeing tour (6:30–9:00 PM) gave the group a chance to unwind and take."
            }
          ]
        },
        {
          "label": "Day 3",
          "date": "18 July",
          "items": [
            {
              "title": "World Got a Problem — Phase B: Present Your Solution",
              "text": "Each team took the stage for five to six minutes to present their proposed solution to a panel of judges, scored on innovation, relevance to their SDG, feasibility, sustainability, presentation and teamwork."
            }
          ]
        },
        {
          "label": "Day 3 Night",
          "date": "18 July",
          "items": [
            {
              "title": "Certificates, \"04:04\" & Cultural Night",
              "text": "The summit closed with Certificates of Participation and a \"04:04 — hear you out\" reflection session, followed by the optional Cultural Night: a celebration of unity in diversity with traditional attire, an open dance floor, and a Rabindra Sangeet performance in Japanese, German and English by."
            }
          ]
        }
      ]
    },
