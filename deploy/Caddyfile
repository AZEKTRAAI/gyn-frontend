# GYN production Caddyfile.
# SITE_ADDRESS is set in .env (e.g. thegyn.org or www.thegyn.org).
# Caddy handles automatic HTTPS via Let's Encrypt; no manual certificate work needed.

{$SITE_ADDRESS} {

    # Compress responses. zstd first (smaller, faster); gzip for older clients.
    encode zstd gzip

    # Reject request bodies over 25 MB before they reach Next.js.
    # Participant file uploads are capped at 2 MB per file in the app itself;
    # 25 MB gives room for multi-file form submissions with overhead.
    request_body {
        max_size 25MB
    }

    # Public media files (event photos, logos, gallery images) served directly by Caddy.
    # The uploads volume is mounted read-only at /srv/uploads.
    # root is /srv/uploads/public, so /srv/uploads/private is unreachable via this block.
    # Path traversal is not possible: Caddy sanitises URL paths before matching.
    handle_path /media/* {
        root * /srv/uploads/public
        file_server
        # Long-lived cache: filenames include a content hash (uploaded with random keys).
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Block .env, .git, .htaccess and any other dotfile or dotdirectory unconditionally.
    @dotfiles path_regexp ^/\.
    respond @dotfiles 404

    # Reverse proxy to the Next.js standalone server.
    #
    # flush_interval -1: Caddy flushes each write immediately.
    # Required for React Suspense streaming to work end-to-end (Next.js self-hosting guide:
    # "ensure that your entire infrastructure supports streaming"). Caddy does not buffer
    # by default, but -1 makes it explicit.
    reverse_proxy app:3000 {
        flush_interval -1

        # X-Forwarded-For and X-Forwarded-Proto are set by Caddy automatically.
        # X-Real-IP is an additional header some apps expect alongside X-Forwarded-For.
        header_up X-Real-IP {remote_host}

        transport http {
            # read_timeout: how long to wait for a response header from Next.js.
            # 30s is generous for SSR; long-running admin exports should use a separate route
            # with a higher timeout if needed.
            read_timeout  30s
            # write_timeout: how long to keep writing the response body to the client.
            # 60s allows slow clients to receive streamed responses.
            write_timeout 60s
        }
    }
}

# --- Running Caddy behind an existing Apache/nginx on the same VPS ---
#
# The old WordPress site currently owns ports 80 and 443 (Apache or nginx, unknown until
# we hear from GYN). To deploy the Next.js app on a test subdomain (e.g. new.thegyn.org)
# without touching WordPress:
#
#  1. Change SITE_ADDRESS in .env to :8080 (or any free port).
#  2. Remove the caddy_data and caddy_config volumes from docker-compose.yml (Caddy manages
#     no TLS in this mode; TLS is terminated by the existing server).
#  3. In docker-compose.yml change Caddy's ports to ["127.0.0.1:8080:8080"].
#  4. Configure the existing Apache/nginx to proxy new.thegyn.org to 127.0.0.1:8080:
#
#     Apache (mod_proxy):
#       ProxyPass        / http://127.0.0.1:8080/
#       ProxyPassReverse / http://127.0.0.1:8080/
#
#     nginx:
#       location / {
#           proxy_pass         http://127.0.0.1:8080;
#           proxy_set_header   Host              $host;
#           proxy_set_header   X-Forwarded-Proto https;
#           proxy_buffering    off;   # required for streaming
#       }
#
#  5. Uncomment the block below and comment out the {$SITE_ADDRESS} block above.
#
# :8080 {
#     encode zstd gzip
#     request_body { max_size 25MB }
#     handle_path /media/* {
#         root * /srv/uploads/public
#         file_server
#         header Cache-Control "public, max-age=31536000, immutable"
#     }
#     @dotfiles path_regexp ^/\.
#     respond @dotfiles 404
#     reverse_proxy app:3000 {
#         flush_interval -1
#         header_up X-Real-IP {remote_host}
#         transport http {
#             read_timeout  30s
#             write_timeout 60s
#         }
#     }
# }
