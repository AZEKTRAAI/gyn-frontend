# GYN production Caddyfile: two sites, both HTTPS only.
#   SITE_ADDRESS   the public website,  e.g. thegyn.org
#   ADMIN_ADDRESS  the separate admin,  e.g. admin.thegyn.org
# Both are set in .env. For every named domain Caddy gets and renews a Let's Encrypt certificate by itself and
# redirects plain http (port 80) to https. There is no http-only site in this file.

# Shared by both sites.
(common) {
    encode zstd gzip

    # Uploaded public media (event photos, logos, gallery images) is served by Caddy straight from disk.
    # Uploads have random names of the form /media/ab/cd/<32 hex>.<ext>. Only that exact shape is matched here, because
    # the website's own built-in photos (hero, speakers, gallery, logos) are static files that also live under /media/
    # and must still reach the app. The uploads volume is mounted read-only at /srv/uploads and root is its public/
    # folder, so private/ is unreachable. Caddy sanitises URL paths before matching.
    @uploads path_regexp ^/media/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{32}\.[a-z0-9]{2,5}$
    handle @uploads {
        uri strip_prefix /media
        root * /srv/uploads/public
        file_server
        # Long-lived cache: uploaded filenames are random, so a changed file always has a new URL.
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Block .env, .git, .htaccess and any other dotfile or dotdirectory.
    @dotfiles path_regexp ^/\.
    respond @dotfiles 404

    # The website and the admin talk to each other over the private Docker network. These routes are never public.
    @internal path /api/internal/*
    respond @internal 404
}

# --- Public website ----------------------------------------------------------
{$SITE_ADDRESS} {
    import common

    # Reject request bodies over 25 MB before they reach Next.js.
    # Participant file uploads are capped at 2 MB per file in the app; 25 MB leaves room for multi-file submissions.
    request_body {
        max_size 25MB
    }

    # flush_interval -1: flush each write immediately, required for React Suspense streaming end to end.
    reverse_proxy web:3000 {
        flush_interval -1
        header_up X-Real-IP {remote_host}
        transport http {
            read_timeout  30s
            write_timeout 60s
        }
    }
}

# --- Admin (separate app, own login) -----------------------------------------
{$ADMIN_ADDRESS} {
    import common

    # Optional: only these addresses can even reach the admin. ADMIN_ALLOWED_IPS is a space-separated list of
    # addresses or ranges in .env; the default allows everyone (the admin still needs a login).
    @outside not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
    respond @outside 403

    # Admin uploads are images up to 4 MB.
    request_body {
        max_size 10MB
    }

    reverse_proxy admin:3100 {
        flush_interval -1
        header_up X-Real-IP {remote_host}
        transport http {
            read_timeout  30s
            write_timeout 60s
        }
    }
}

# --- Running behind an existing Apache/nginx on the same VPS ------------------
#
# The old WordPress site owns ports 80 and 443 until the DNS cutover. To test this stack on subdomains without
# touching WordPress, let the existing server terminate TLS and forward to Caddy on a local port:
#
#  1. In docker-compose.yml publish Caddy as ["127.0.0.1:8080:8080"] (remove 80 and 443) and drop the caddy_data volume.
#  2. Make the two site blocks above listen on :8080 with Caddy's http scheme, e.g. `http://new.thegyn.org:8080`
#     and `http://new-admin.thegyn.org:8080` (SITE_ADDRESS and ADMIN_ADDRESS in .env), so Caddy does not ask for certificates.
#  3. Point Apache or nginx at 127.0.0.1:8080 for both hostnames, keeping the Host header, and let it serve https:
#
#     nginx:
#       location / {
#           proxy_pass         http://127.0.0.1:8080;
#           proxy_set_header   Host              $host;
#           proxy_set_header   X-Forwarded-Proto https;
#           proxy_buffering    off;   # required for streaming
#       }
#
#  The outside world still only sees https; the plain-http hop is on the server itself (127.0.0.1).
