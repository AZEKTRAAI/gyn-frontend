// GYN website and registration system: PostgreSQL schema.
// Design notes live in docs/backend-plan.md. Rules this file follows:
//  - Money is whole minor units (cents) plus a currency code.
//  - Nothing that matters is hard-deleted: events, categories, forms and registrations are archived or soft-deleted.
//  - Published form versions and letter template versions never change (enforced by triggers in the first migration).
//  - A registration keeps a snapshot of the answers WITH their labels, so later form edits cannot alter history.
//  - Sensitive answers and documents are encrypted by the application (lib/server/crypto.ts) before they reach this database.
//  - Anything that must happen later (email, letters, payment re-checks) is a Job row written in the same transaction as the cause.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URLs live in prisma.config.ts (Prisma 7): DIRECT_URL for migrate, DATABASE_URL passed to the pg adapter at runtime.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Upcoming or past is computed from endsAt. This overrides it for edge cases.
enum EventTiming {
  UPCOMING
  PAST
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum ApprovalMode {
  AUTOMATIC     // accepted when payment is verified; the personalised email goes out by itself (Self-Funded, Forum Access)
  MANUAL_REVIEW // waits in the review panel; an admin decides and sends the email (scholarship applications and other scenarios)
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum DuplicateRule {
  NONE
  EMAIL_PER_FORM
  EMAIL_PER_EVENT
}

// Used for the registration's overall payment state and for each payment attempt.
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  ACTION_REQUIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Kept separate from PaymentStatus on purpose (SRS 3.10 C): paying does not accept, failing to pay does not reject.
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  WAITLISTED
  REJECTED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum RefundType {
  GYN_CREDIT_VOUCHER // the refund policy pays approved refunds as vouchers
  CASH_ORIGINAL      // exception path; needs the finance permission
}

enum RefundStatus {
  PENDING
  ISSUED
  FAILED
}

enum WebhookProvider {
  STRIPE
  PAYPAL
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LetterTrigger {
  REGISTRATION_SUBMITTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  APPLICATION_ACCEPTED
  APPLICATION_WAITLISTED
  APPLICATION_REJECTED
  MANUAL
}

enum LetterDelivery {
  ATTACH_PDF
  DOWNLOAD_LINK
}

enum LetterStatus {
  AWAITING_ACTION // review category: nothing is sent until an admin decides
  GENERATED
  SENT
  FAILED
  NEEDS_REVIEW // a required merge field was empty; held instead of sending a broken letter
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED // out of attempts; shown in the admin
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum FileVisibility {
  PUBLIC  // served by Caddy at /media
  PRIVATE // only through the admin download route
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Admin users, roles, sessions, settings, audit
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // Permission names checked in code, for example "registrations.export" or "applications.decide".
  permissions String[]
  // The six roles from SRS section 7 are system roles: their permissions can be edited, they cannot be deleted.
  isSystem    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String // scrypt, see lib/server/password.ts
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  // Two-step login (authenticator app). The secret is encrypted with the field encryption key.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  recoveryCodeHashes Json?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions              Session[]
  auditLogs             AuditLog[]
  registrationsAssigned Registration[]        @relation("RegistrationAssignee")
  registrationsReviewed Registration[]        @relation("RegistrationReviewer")
  notes                 RegistrationNote[]
  mediaUploads          MediaAsset[]
  formsCreated          Form[]
  formVersions          FormVersion[]
  templateVersions      LetterTemplateVersion[]
  lettersSent           GeneratedLetter[]
  refundsRequested      Refund[]
  settingsUpdated       Setting[]
  pageRevisions         PageRevision[]
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the cookie token. The token itself is never stored.
  tokenHash           String    @unique
  expiresAt           DateTime
  lastSeenAt          DateTime  @default(now())
  twoFactorVerifiedAt DateTime?
  ip                  String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// Append-only. A trigger in the first migration blocks UPDATE, and blocks DELETE for rows younger than 3 years.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userEmail  String? // kept as text so the trail survives a deleted user
  action     String // "REGISTRATION_EDITED", "LETTER_SENT", "EXPORT_DOWNLOADED", ...
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Events, categories, pages, media
// ---------------------------------------------------------------------------

model Event {
  id                  String       @id @default(cuid())
  slug                String       @unique
  name                String
  shortName           String?
  theme               String?
  summary             String?
  startsAt            DateTime
  endsAt              DateTime
  timezone            String       @default("UTC")
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  venue               String?
  city                String?
  country             String?
  mapUrl              String?
  // Short label in the navbar dropdowns, e.g. "FMS Thailand"; falls back to the name.
  navLabel            String?
  bannerUrl           String?
  logoUrl             String?
  totalSeats          Int?
  status              EventStatus  @default(DRAFT)
  featured            Boolean      @default(false)
  timingOverride      EventTiming?
  // SEO (SRS section 6)
  seoTitle            String?
  seoDescription      String?
  canonicalUrl        String?
  ogImageUrl          String?
  noindex             Boolean      @default(false)
  deletedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections       EventSection[]
  categories     RegistrationCategory[]
  forms          Form[]
  registrations  Registration[]
  galleries      Gallery[]
  media          MediaAsset[]
  letterTemplates LetterTemplate[]

  @@index([status, endsAt])
  @@index([featured])
}

// A block on an event page. blockType comes from the section library in code; data is validated by that type's zod schema.
model EventSection {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  blockType String
  sortOrder Int
  visible   Boolean  @default(true)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, sortOrder])
}

model RegistrationCategory {
  id           String       @id @default(cuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id])
  slug         String
  name         String // Fully Funded, Partially Funded, Self-Funded, Forum Access, Invitation Letter, ...
  description  String?
  feeCents     Int          @default(0)
  currency     String       @default("USD")
  approvalMode ApprovalMode @default(AUTOMATIC)
  seatLimit    Int?
  sortOrder    Int          @default(0)
  active       Boolean      @default(true)
  opensAt      DateTime?
  closesAt     DateTime?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forms           Form[]
  registrations   Registration[]
  letterTemplates LetterTemplate[]

  @@unique([eventId, slug])
  @@index([eventId, active])
}

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  status          PageStatus @default(DRAFT)
  // Bumped on every publish. Policy pages record which version a participant accepted.
  version         Int        @default(1)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  canonicalUrl    String?
  ogImageUrl      String?
  noindex         Boolean    @default(false)
  // Home, About, Contact and the policy pages cannot be deleted.
  isSystem        Boolean    @default(false)
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  PageSection[]
  revisions PageRevision[]
  forms     Form[]

  @@index([slug])
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockType String
  sortOrder Int
  visible   Boolean  @default(true)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, sortOrder])
}

// A snapshot of the published page, so the exact text a participant accepted can be shown later.
model PageRevision {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id])
  version     Int
  snapshot    Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([pageId, version])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(308)
  createdAt  DateTime @default(now())
}

model Gallery {
  id        String       @id @default(cuid())
  name      String
  eventId   String?
  event     Event?       @relation(fields: [eventId], references: [id])
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  assets MediaAsset[]

  @@index([eventId])
}

model MediaAsset {
  id           String         @id @default(cuid())
  kind         MediaKind      @default(IMAGE)
  visibility   FileVisibility @default(PUBLIC)
  storageKey   String         @unique
  originalName String
  mimeType     String
  bytes        Int
  width        Int?
  height       Int?
  title        String?
  altText      String?
  // Resized copies made at upload: [{ key, width, height }]
  variants     Json?
  galleryId    String?
  gallery      Gallery?       @relation(fields: [galleryId], references: [id])
  eventId      String?
  event        Event?         @relation(fields: [eventId], references: [id])
  sortOrder    Int            @default(0)
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([galleryId, sortOrder])
}

// ---------------------------------------------------------------------------
// Dynamic forms (SRS 3.4)
// ---------------------------------------------------------------------------

model Form {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  description        String?
  eventId            String? // null = a standalone form
  event              Event?        @relation(fields: [eventId], references: [id])
  categoryId         String?
  category           RegistrationCategory? @relation(fields: [categoryId], references: [id])
  status             FormStatus    @default(DRAFT)
  // The version new registrations are made with. Editing creates a new draft version; publishing moves this pointer.
  publishedVersionId String?       @unique
  publishedVersion   FormVersion?  @relation("FormPublished", fields: [publishedVersionId], references: [id])
  opensAt            DateTime?
  closesAt           DateTime? // the worker closes the form at this time
  submissionLimit    Int?
  // Counted inside the submit transaction, so the limit holds under load. A CHECK constraint backs it up.
  submissionCount    Int           @default(0)
  duplicateRule      DuplicateRule @default(NONE)
  paymentRequired    Boolean       @default(false)
  feeCentsOverride   Int?
  currency           String?
  termsPageId        String?
  termsPage          Page?         @relation(fields: [termsPageId], references: [id])
  // Confirmation message, participant email text, admin recipients, allowed gateways, appearance.
  settings           Json          @default("{}")
  archivedAt         DateTime?
  createdById        String?
  createdBy          User?         @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions      FormVersion[] @relation("FormVersions")
  registrations Registration[]

  @@index([eventId, status])
  @@index([categoryId])
  @@index([status, closesAt])
}

// Once publishedAt is set the row is frozen (trigger in the first migration).
model FormVersion {
  id          String    @id @default(cuid())
  formId      String
  form        Form      @relation("FormVersions", fields: [formId], references: [id])
  version     Int
  // steps > sections > fields, validated by features/forms/engine.
  definition  Json
  note        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  publishedAt DateTime? // null = draft

  publishedFor  Form?          @relation("FormPublished")
  registrations Registration[]

  @@unique([formId, version])
}

// ---------------------------------------------------------------------------
// Registrations (SRS 3.2, 3.3, section 4)
// ---------------------------------------------------------------------------

model Registration {
  id            String                @id @default(cuid())
  // Shown to staff as "Entry #8001". Global across all forms and events.
  entryNumber   Int                   @unique @default(autoincrement())
  // Shown to the participant and used in emails, for example SISM26-7K3QX.
  reference     String                @unique
  eventId       String?
  event         Event?                @relation(fields: [eventId], references: [id])
  categoryId    String?
  category      RegistrationCategory? @relation(fields: [categoryId], references: [id])
  formId        String
  form          Form                  @relation(fields: [formId], references: [id])
  // The exact version the participant saw. History never changes when the form is edited later.
  formVersionId String
  formVersion   FormVersion           @relation(fields: [formVersionId], references: [id])

  // Copied from the answers when the form maps a field to one of these, so lists can sort, search and filter without opening JSON.
  firstName          String?
  middleName         String?
  lastName           String?
  email              String?
  emailNormalized    String? // lower-cased and trimmed
  whatsapp           String?
  nationality        String?
  gender             String?
  countryOfResidence String?
  cityOfDeparture    String?

  // { fieldId: { label, type, value } }. Values of fields marked sensitive are encrypted strings ("enc:v1:...").
  answers       Json
  amountDueCents Int               @default(0)
  currency      String             @default("USD")

  paymentStatus     PaymentStatus      @default(NOT_REQUIRED)
  // Only on MANUAL_REVIEW categories until accepted; AUTOMATIC ones become ACCEPTED when payment is verified.
  applicationStatus ApplicationStatus?
  assignedToId      String?
  assignedTo        User?              @relation("RegistrationAssignee", fields: [assignedToId], references: [id])
  reviewedById      String?
  reviewedBy        User?              @relation("RegistrationReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  decisionNote      String?

  termsPageId     String?
  termsVersion    Int?
  termsAcceptedAt DateTime?

  favourite Boolean   @default(false)
  isRead    Boolean   @default(false)
  isSpam    Boolean   @default(false)
  trashedAt DateTime?

  // "form:<id>:<email>" or "event:<id>:<email>" when the form has a duplicate rule, otherwise null. Unique, so two
  // simultaneous submissions cannot both succeed. Cleared when a registration is trashed.
  duplicateKey   String? @unique
  // Sent by the browser with every submit, so a double click or a retry after a timeout cannot create a second row.
  idempotencyKey String  @unique
  ip             String?
  userAgent      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files    RegistrationFile[]
  notes    RegistrationNote[]
  payments Payment[]
  refunds  Refund[]
  letters  GeneratedLetter[]
  emails   EmailMessage[]

  @@index([eventId, createdAt])
  @@index([formId, createdAt])
  @@index([categoryId, paymentStatus])
  @@index([paymentStatus, createdAt])
  @@index([applicationStatus, createdAt])
  @@index([emailNormalized])
  @@index([nationality])
  @@index([createdAt])
}

// Encrypted on disk (lib/server/storage.ts). storageKey is random; the original name is only for the download header.
model RegistrationFile {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])
  fieldId        String
  storageKey     String       @unique
  originalName   String
  mimeType       String
  bytes          Int
  sha256         String
  encrypted      Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([registrationId])
}

model RegistrationNote {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([registrationId, createdAt])
}

// ---------------------------------------------------------------------------
// Payments (SRS section 5, 3.10)
// ---------------------------------------------------------------------------

// One row per attempt, so a failed attempt and a later successful retry are both kept.
model Payment {
  id                 String          @id @default(cuid())
  registrationId     String
  registration       Registration    @relation(fields: [registrationId], references: [id])
  provider           PaymentProvider
  status             PaymentStatus   @default(PENDING)
  amountCents        Int
  currency           String
  providerOrderId    String? // Stripe Checkout Session id, PayPal order id
  providerPaymentId  String? // Stripe payment intent, PayPal capture id
  providerCustomerId String?
  failureReason      String?
  // What the gateway reported. Never card data.
  gatewayResponse    Json?
  idempotencyKey     String          @unique
  paidAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@unique([provider, providerOrderId])
  @@index([registrationId])
  @@index([providerPaymentId])
  @@index([status, createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id])
  registrationId   String
  registration     Registration @relation(fields: [registrationId], references: [id])
  providerRefundId String?
  idempotencyKey   String?      @unique
  amountCents      Int
  type             RefundType   @default(GYN_CREDIT_VOUCHER)
  status           RefundStatus @default(PENDING)
  voucherCode      String?      @unique
  voucherExpiresAt DateTime?
  reason           String?
  requestedById    String?
  requestedBy      User?        @relation(fields: [requestedById], references: [id])
  requestedAt      DateTime     @default(now())
  processedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([registrationId])
}

// A repeated delivery from Stripe or PayPal hits the unique key and does nothing.
model WebhookEvent {
  id              String          @id @default(cuid())
  provider        WebhookProvider
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  failureReason   String?
  createdAt       DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, eventType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Letters and email (SRS 3.8 to 3.10)
// ---------------------------------------------------------------------------

model LetterTemplate {
  id              String         @id @default(cuid())
  name            String
  purpose         String?
  trigger         LetterTrigger
  status          TemplateStatus @default(INACTIVE)
  eventId         String?
  event           Event?         @relation(fields: [eventId], references: [id])
  categoryId      String?
  category        RegistrationCategory? @relation(fields: [categoryId], references: [id])
  // true: send only after the payment is verified (the default). false: send before payment.
  requirePayment  Boolean        @default(true)
  delivery        LetterDelivery @default(ATTACH_PDF)
  linkExpiresDays Int?
  // GYN's letterhead (a one-page PDF or an A4 image): the letter text is printed on top of it.
  letterheadKey   String?
  currentVersionId String?       @unique
  currentVersion   LetterTemplateVersion? @relation("TemplateCurrent", fields: [currentVersionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions LetterTemplateVersion[] @relation("TemplateVersions")
  letters  GeneratedLetter[]

  @@index([trigger, status])
  @@index([eventId, categoryId])
}

// Every edit is a new version. Frozen once written (trigger), because sent letters point at the version they used.
model LetterTemplateVersion {
  id          String         @id @default(cuid())
  templateId  String
  template    LetterTemplate @relation("TemplateVersions", fields: [templateId], references: [id])
  version     Int
  // The personalised email that carries the letter (or is the whole message when there is no PDF).
  subject     String?
  emailBody   Json?
  // The PDF letter. null = this template sends an email only.
  content     Json?
  header      Json?
  footer      Json?
  signatory   Json?
  note        String?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  currentFor LetterTemplate? @relation("TemplateCurrent")
  letters    GeneratedLetter[]

  @@unique([templateId, version])
}

model GeneratedLetter {
  id                String                @id @default(cuid())
  registrationId    String
  registration      Registration          @relation(fields: [registrationId], references: [id])
  templateId        String
  template          LetterTemplate        @relation(fields: [templateId], references: [id])
  templateVersionId String
  templateVersion   LetterTemplateVersion @relation(fields: [templateVersionId], references: [id])
  trigger           LetterTrigger
  status            LetterStatus          @default(AWAITING_ACTION)
  storageKey        String? // the PDF, in private storage
  recipientEmail    String?
  // "<registrationId>:<templateId>:<trigger>" for automatic sends: unique, so a repeated trigger cannot send twice.
  // Null for manual sends, resends and regenerations, which need a reason.
  autoKey           String?               @unique
  reason            String?
  sentById          String?
  sentBy            User?                 @relation(fields: [sentById], references: [id])
  // The admin's changes to the email text for this one person (manual route).
  editedBody        Json?
  error             String?
  generatedAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())

  emails EmailMessage[]

  @@index([registrationId])
  @@index([status, createdAt])
}

// Wording for the other emails: registration confirmation, payment success, payment failed, contact auto-reply, admin alerts.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String
  // "global", "event:<id>" or "category:<id>". A more specific scope wins.
  scopeKey  String   @default("global")
  name      String
  subject   String
  body      Json
  active    Boolean  @default(true)
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, scopeKey])
}

// The outbox and the delivery log in one table. The worker sends QUEUED rows.
model EmailMessage {
  id             String          @id @default(cuid())
  toEmail        String
  toName         String?
  templateKey    String?
  subject        String
  bodyHtml       String
  bodyText       String?
  // Private storage keys of attached PDFs.
  attachmentKeys String[]
  status         EmailStatus     @default(QUEUED)
  attempts       Int             @default(0)
  lastError      String?
  scheduledAt    DateTime        @default(now())
  sentAt         DateTime?
  registrationId String?
  registration   Registration?   @relation(fields: [registrationId], references: [id])
  letterId       String?
  letter         GeneratedLetter? @relation(fields: [letterId], references: [id])
  // For example "payment_success:<paymentId>": a repeated trigger cannot queue the same email twice.
  dedupeKey      String?         @unique
  createdById    String?
  createdAt      DateTime        @default(now())

  @@index([status, scheduledAt])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Job queue (the worker process, lib/server/jobs.ts)
// ---------------------------------------------------------------------------

// Written in the same transaction as whatever caused it, so "the registration exists but its email job is lost" cannot happen.
model Job {
  id          String    @id @default(cuid())
  // "send_email", "generate_letter", "recheck_payment", "close_form", "reconcile", ...
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(8)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([type, status])
}

// ---------------------------------------------------------------------------
// Contact form (SRS 2.5)
// ---------------------------------------------------------------------------

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  topic       String
  message     String
  ipAddress   String?
  status      ContactStatus @default(NEW)
  readAt      DateTime?
  submittedAt DateTime      @default(now())

  @@index([status, submittedAt])
}
